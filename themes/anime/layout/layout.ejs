<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= page.description || config.description %>">
  <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
  <link rel="icon" type="image/svg+xml" href="<%- url_for('/img/favicon.svg') %>">
  <link rel="apple-touch-icon" href="<%- url_for('/img/favicon.svg') %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <% var bg = theme.background || {}; %>
  <% if (bg.light || bg.dark) { %>
  <style>
    /* 全站背景壁纸（由主题配置 background 生成） */
    <% if (bg.light) { %>html[data-theme='light'] #site-bg { background-image: url('<%- url_for(bg.light) %>'); }<% } %>
    <% if (bg.dark) { %>html[data-theme='dark'] #site-bg { background-image: url('<%- url_for(bg.dark) %>'); }<% } %>
    #site-bg::after { opacity: <%= typeof bg.veil === 'number' ? bg.veil : 0.88 %>; }
  </style>
  <% } %>
  <script>
    // 首屏读取主题偏好，避免闪烁；并标记 View Transitions 支持情况（pjax 换页用同文档 VT）
    (function () {
      var t = localStorage.getItem('theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
      if (document.startViewTransition) document.documentElement.classList.add('vt');
      // 壁纸在本会话已加载过（浏览器已缓存）时，首帧直接显示，消除跳转时的壁纸空窗闪白
      try { if (sessionStorage.getItem('anime-bg-ready')) document.documentElement.classList.add('bg-cached'); } catch (e) {}
    })();
  </script>
</head>
<body class="<%= is_home() && (!page.current || page.current === 1) ? 'is-home' : '' %>">
  <div id="site-bg" aria-hidden="true"></div>
  <%- partial('_partial/header') %>

  <main class="site-main">
    <%- body %>
  </main>

  <%- partial('_partial/footer') %>
  <%- partial('_partial/search-modal') %>

  <!-- 后续拓展挂载点：Live2D 看板娘 / 音乐播放器 -->
  <div id="live2d-mount"></div>
  <div id="player-mount"></div>

  <script>
    window.ANIME_THEME = {
      root: '<%- config.root %>',
      quoteInterval: <%= theme.quote_interval || 8000 %>,
      thoughtsPerPage: <%= theme.thoughts_per_page || 10 %>,
      walineServer: '<%= theme.waline.serverURL %>',
      bgLight: '<%- (theme.background && theme.background.light) ? url_for(theme.background.light) : '' %>',
      bgDark: '<%- (theme.background && theme.background.dark) ? url_for(theme.background.dark) : '' %>',
      live2d: <%- JSON.stringify(theme.live2d || {}) %>,
      music: <%- JSON.stringify(theme.music || {}) %>
    };
  </script>
  <script src="<%- url_for('/js/main.js') %>"></script>
  <script src="<%- url_for('/js/search.js') %>"></script>
  <script src="<%- url_for('/js/widgets.js') %>"></script>
  <!-- Vercel Speed Insights（静态站接入方式，等价于 Next 的 <SpeedInsights /> 组件）；
       脚本由 Vercel 部署环境注入，本地 hexo server 下 404 属正常 -->
  <script>
    window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/speed-insights/script.js"></script>
</body>
</html>
