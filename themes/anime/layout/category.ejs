<section class="container post-list">
  <h2 class="section-title"><span>🗂</span> 分类：<%= page.category %></h2>
  <div class="cards">
    <% page.posts.each(function (post) { %>
      <%- partial('_partial/post-card', { post: post }) %>
    <% }) %>
  </div>
  <%- partial('_partial/paginator') %>
</section>
