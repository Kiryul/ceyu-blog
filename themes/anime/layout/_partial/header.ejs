<header class="site-header" id="site-header">
  <a class="brand" href="<%- url_for('/') %>">
    <span class="brand-mark">✦</span><%= config.title %>
  </a>

  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="展开菜单">
  <label for="nav-toggle" class="nav-toggle-btn"><span></span><span></span><span></span></label>

  <nav class="site-nav">
    <% for (const [name, link] of Object.entries(theme.menu)) { %>
      <a class="nav-link <%= (is_current(link) || (link === '/' && is_home())) ? 'active' : '' %>" href="<%- url_for(link) %>"><%= name %></a>
    <% } %>
    <button class="icon-btn" id="search-btn" type="button" aria-label="搜索" title="搜索">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
    </button>
    <button class="icon-btn" id="theme-btn" type="button" aria-label="切换主题" title="切换亮/暗主题">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>
